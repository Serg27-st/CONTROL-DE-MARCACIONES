<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Control de Marcación</title>
    <link rel="stylesheet" href="~/css/sitio.css" asp-append-version="true" />
</head>
<body style="background: var(--color-primario); min-height: 100vh; display: flex; align-items: center; justify-content: center;">
    <main style="width: 100%; max-width: 420px; padding: 24px;">
        <div style="text-align: center; color: #fff; margin-bottom: 20px;">
            <div style="font-weight: 700; font-size: 20px; letter-spacing: 0.02em;">GCA</div>
            <div style="font-size: 14px; color: #cbd5e1;">Control de Marcación</div>
        </div>

        @RenderBody()
    </main>
</body>
</html>
