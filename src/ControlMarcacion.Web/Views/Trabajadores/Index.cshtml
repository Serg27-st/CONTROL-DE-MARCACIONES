@model ListadoTrabajadoresVm
@{
    ViewData["Title"] = "Personal";
    var r = Model.Resultado;
}

<div class="titulo-pagina">
    <h1>Mantenimiento de personal</h1>
    <div>
        <a class="boton boton-secundario" asp-action="CargaMasiva">Carga masiva</a>
        <a class="boton boton-primario" asp-action="Crear">Nuevo trabajador</a>
    </div>
</div>

<div class="tarjeta">
    <h2>Filtros</h2>
    <form method="get" asp-action="Index">
        <div class="rejilla">
            <div class="campo">
                <label for="Busqueda">Buscar</label>
                <input type="search" id="Busqueda" name="Busqueda" value="@Model.Filtro.Busqueda"
                       placeholder="Documento, apellidos o nombres" />
            </div>

            <div class="campo">
                <label for="EmpresaId">Empresa</label>
                <select id="EmpresaId" name="EmpresaId" class="select-buscable">
                    <option value="">Todas</option>
                    @foreach (var empresa in Model.Empresas)
                    {
                        <option value="@empresa.Id" selected="@(Model.Filtro.EmpresaId == empresa.Id)">@empresa.Nombre</option>
                    }
                </select>
            </div>

            <div class="campo">
                <label for="PlantaId">Planta</label>
                <select id="PlantaId" name="PlantaId" class="select-buscable">
                    <option value="">Todas</option>
                    @foreach (var planta in Model.Plantas)
                    {
                        <option value="@planta.Id" selected="@(Model.Filtro.PlantaId == planta.Id)">@planta.Nombre</option>
                    }
                </select>
            </div>

            <div class="campo">
                <label for="CentroId">Centro</label>
                <select id="CentroId" name="CentroId" class="select-buscable">
                    <option value="">Todos</option>
                    @foreach (var centro in Model.Centros)
                    {
                        <option value="@centro.Id" selected="@(Model.Filtro.CentroId == centro.Id)">@centro.Nombre</option>
                    }
                </select>
            </div>

            <div class="campo">
                <label for="CentroCostoId">Centro de costo</label>
                <select id="CentroCostoId" name="CentroCostoId" class="select-buscable">
                    <option value="">Todos</option>
                    @foreach (var centroCosto in Model.CentrosCosto)
                    {
                        <option value="@centroCosto.Id" selected="@(Model.Filtro.CentroCostoId == centroCosto.Id)">@centroCosto.Nombre</option>
                    }
                </select>
            </div>

            <div class="campo">
                <label for="TipoPlanilla">Tipo de planilla</label>
                <select id="TipoPlanilla" name="TipoPlanilla">
                    <option value="">Todos</option>
                    <option value="@((int)TipoPlanilla.Obrero)" selected="@(Model.Filtro.TipoPlanilla == TipoPlanilla.Obrero)">Obrero (OBM)</option>
                    <option value="@((int)TipoPlanilla.Empleado)" selected="@(Model.Filtro.TipoPlanilla == TipoPlanilla.Empleado)">Empleado (EMP)</option>
                </select>
            </div>

            <div class="campo">
                <label for="SoloActivos">Situación</label>
                <select id="SoloActivos" name="SoloActivos">
                    <option value="true" selected="@(Model.Filtro.SoloActivos == true)">Solo vigentes</option>
                    <option value="false" selected="@(Model.Filtro.SoloActivos == false)">Solo cesados</option>
                    <option value="" selected="@(Model.Filtro.SoloActivos == null)">Todos</option>
                </select>
            </div>
        </div>

        <div class="acciones">
            <button type="submit" class="boton boton-primario">Buscar</button>
            <a class="boton boton-secundario" asp-action="Index">Limpiar</a>
        </div>
    </form>
</div>

<div class="busqueda-rapida">
    <input type="search" id="BuscarRapidoInput" autocomplete="off"
           placeholder="Búsqueda rápida: documento, apellidos, nombres o ID de marcador…" />
    <div id="BuscarRapidoResultados" class="busqueda-rapida-resultados" hidden></div>
</div>

<div class="tarjeta" id="resultados-personal">
    @if (r.TotalElementos == 0)
    {
        <div class="sin-resultados">
            No se encontraron trabajadores con los filtros seleccionados.
        </div>
    }
    else
    {
        <div class="tabla-contenedor">
            <table class="tabla">
                <thead>
                    <tr>
                        <th>Documento</th>
                        <th>Apellidos y nombres</th>
                        <th>Empresa</th>
                        <th>Planta</th>
                        <th>Centro</th>
                        <th>Centro de costo</th>
                        <th>Puesto</th>
                        <th>Turno</th>
                        <th>ID marcador</th>
                        <th>Ingreso</th>
                        <th>Situación</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in r.Elementos)
                    {
                        <tr>
                            <td>@t.TipoDocumento @t.NumeroDocumento</td>
                            <td>@t.ApellidosYNombres</td>
                            <td>@t.Empresa</td>
                            <td>@t.Planta</td>
                            <td>@(t.Centro ?? "—")</td>
                            <td>@(t.CentroCosto ?? "—")</td>
                            <td>@t.Puesto</td>
                            <td>@(t.TurnoVigente ?? "—")</td>
                            <td>@(t.IdMarcador ?? "—")</td>
                            <td>@t.FechaIngreso.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (t.EstaActivo)
                                {
                                    <span class="etiqueta etiqueta-puntual">Vigente</span>
                                }
                                else
                                {
                                    <span class="etiqueta etiqueta-cesado">Cesado @t.FechaCese!.Value.ToString("dd/MM/yyyy")</span>
                                }
                            </td>
                            <td class="acciones-fila">
                                <button type="button" class="enlace-accion" data-panel-abrir data-panel-id="@t.Id" data-panel-modo="ver">Ver</button>
                                <button type="button" class="enlace-accion" data-panel-abrir data-panel-id="@t.Id" data-panel-modo="editar">Editar</button>
                                <a class="enlace-accion" asp-action="Historial" asp-route-id="@t.Id">Historial</a>
                                @if (t.EstaActivo)
                                {
                                    <a class="enlace-accion" asp-action="Baja" asp-route-id="@t.Id">Baja</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Paginacion"
                 model='PaginacionVm.De(r, "Index", "trabajador(es)", Model.RutaFiltros())' />
    }
</div>

<div id="panel-trabajador-contenedor"></div>

@section Scripts {
    <script src="~/js/panel-trabajador.js" asp-append-version="true"></script>
    <script src="~/js/documento-restriccion.js" asp-append-version="true"></script>
}
