@model CargaMasivaVm
@{
    ViewData["Title"] = "Carga masiva de personal";
    var resultado = Model.Resultado;
}

<div class="titulo-pagina">
    <h1>Carga masiva de personal</h1>
    <a class="boton boton-secundario" asp-action="Index">Volver al listado</a>
</div>

<div class="tarjeta">
    <h2>1. Prepare el archivo</h2>

    <p class="texto-suave">
        El archivo puede ser un <strong>Excel (.xlsx)</strong> o un CSV, con una fila por
        trabajador. La primera fila es el encabezado y
        <strong>el orden de las columnas no importa</strong>: se reconocen por su nombre.
        Los catálogos se indican por su código o su nombre —"DNI", "CONSULTING ADVISERS",
        "DETERGENTES", "OPER"—, nunca por su número interno.
    </p>

    <p class="texto-suave">
        Columnas obligatorias: <code>tipo_documento</code>, <code>numero_documento</code>,
        <code>apellido_paterno</code>, <code>apellido_materno</code>, <code>nombres</code>,
        <code>sexo</code>, <code>empresa</code>, <code>unidad</code>,
        <code>tipo_planilla</code>, <code>puesto</code> y <code>fecha_ingreso</code>
        (formato <code>dd/mm/aaaa</code>).
        <br />
        Opcionales: <code>telefono</code>, <code>direccion</code>, <code>correo</code>,
        <code>tiene_hijos</code>, <code>centro_costo</code>, <code>id_marcador</code>,
        <code>turno</code>, <code>sueldo_basico</code>, <code>codigo_unidad</code>,
        <code>equipo</code>, <code>codigo_equipo</code>, <code>nombre_equipo</code> y
        <code>serie_equipo</code>.
    </p>

    <p style="color: var(--color-texto-suave); margin-bottom: 0;">
        Si una unidad no existe, indique también <code>codigo_unidad</code>. Si el equipo
        tampoco existe, indique <code>codigo_equipo</code> y <code>nombre_equipo</code>;
        la serie es opcional. El análisis mostrará qué elementos ya existen y cuáles se
        crearán antes de pedir confirmación.
    </p>

    <div class="acciones">
        <a class="boton boton-secundario" asp-action="PlantillaCargaMasiva">
            Descargar plantilla de ejemplo
        </a>
    </div>
</div>

<div class="tarjeta">
    <h2>2. Cárguelo</h2>

    <form method="post" asp-action="ProcesarCargaMasiva" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="campo">
            <label for="archivo">Archivo CSV o Excel</label>
            <input type="file" id="archivo" name="archivo" accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required />
        </div>

        <div class="campo campo-casilla">
            <input type="checkbox" id="actualizarExistentes" name="actualizarExistentes" value="true" />
            <label for="actualizarExistentes">Actualizar los trabajadores que ya existan</label>
        </div>

        <div class="campo campo-casilla">
            <input type="checkbox" id="registrarMarcadores" name="registrarMarcadores" value="true" checked />
            <label for="registrarMarcadores">Registrar en el catálogo los ID de marcador que falten</label>
        </div>

        <div class="acciones">
            <button type="submit" class="boton boton-primario">
                Analizar plantilla
            </button>
        </div>

        <p class="nota-pie">
            <strong>Analizar plantilla</strong> procesa el archivo completo sin guardar y
            muestra los puestos existentes, los nuevos propuestos y cualquier ambigüedad.
            La importación solo se ejecuta después de una confirmación explícita.
            <br />
            Al cargar, las filas válidas se registran aunque otras fallen. Las rechazadas se
            listan con su número de fila y el motivo.
            <br />
            <strong>Actualizar los que ya existan</strong> hace que un documento ya
            registrado <em>corrija</em> esa ficha en lugar de rechazarse por duplicado. Úselo
            para volver a subir el mismo padrón con un dato que faltaba —los ceses, por
            ejemplo—. Apagado, la carga solo da de alta.
            <br />
            <strong>Registrar los ID de marcador que falten</strong> da de alta en el catálogo,
            en el aparato que indica la columna <code>equipo</code>, cada ID que todavía no
            exista. Así el primer padrón no exige registrar antes, uno por uno, los cien ID de
            cada aparato. Solo agrega: nunca cambia un código existente. Si la unidad tiene dos
            aparatos y la fila no dice cuál, la fila se rechaza en vez de adivinar. Apáguelo si
            el catálogo ya está completo y quiere que un ID desconocido —un error de tipeo— se
            rechace.
        </p>
    </form>
</div>

@if (resultado is not null)
{
    <div class="tarjeta">
        <h2>@(resultado.SoloValidacion ? "Resultado de análisis de plantilla" : "Resultado de importación")</h2>

        @if (resultado.SoloValidacion)
        {
            <div class="aviso aviso-error" role="status">
                <strong>Validación: no se guardó nada.</strong>
                Se revisaron @resultado.FilasLeidas fila(s) de <code>@resultado.NombreArchivo</code>.
                @if (resultado.TieneErrores)
                {
                    <text>@resultado.Rechazados serían rechazadas; las demás pasarían sin problema.</text>
                }
                else
                {
                    <text>Todas pasarían sin problema.</text>
                }
            </div>
        }

        <div class="aviso aviso-atencion" role="status">
            <strong>Dependencias conciliadas:</strong>
            @resultado.Conciliacion.Unidades.Count unidad(es),
            @resultado.Conciliacion.Equipos.Count equipo(s) y
            @resultado.Conciliacion.Marcadores.Count marcador(es).
            Nuevos propuestos: @resultado.Conciliacion.UnidadesNuevas unidad(es),
            @resultado.Conciliacion.EquiposNuevos equipo(s) y
            @resultado.Conciliacion.MarcadoresNuevos marcador(es).
        </div>

        @if (resultado.Conciliacion.Unidades.Count > 0 || resultado.Conciliacion.Equipos.Count > 0)
        {
            <div class="tabla-contenedor">
                <table class="tabla">
                    <thead>
                        <tr><th>Tipo</th><th>Código / referencia</th><th>Nombre</th><th>Contexto</th><th>Estado</th><th>Filas</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var unidad in resultado.Conciliacion.Unidades)
                        {
                            <tr><td>Unidad</td><td>@unidad.Clave</td><td>@unidad.Nombre</td><td>@unidad.Contexto</td><td>@unidad.Estado</td><td>@unidad.FilasAfectadas</td></tr>
                        }
                        @foreach (var equipo in resultado.Conciliacion.Equipos)
                        {
                            <tr><td>Equipo</td><td>@equipo.Clave</td><td>@equipo.Nombre</td><td>@equipo.Contexto</td><td>@equipo.Estado</td><td>@equipo.FilasAfectadas</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (resultado.Conciliacion.TieneBloqueos)
        {
            <div class="aviso aviso-error" role="alert">
                Hay dependencias ambiguas, inválidas o con datos incompletos. Corrija la
                plantilla y vuelva a analizarla; no se habilitará la confirmación.
            </div>
        }

        <div class="aviso aviso-atencion" role="status">
            <strong>@resultado.Puestos.Diferentes puesto(s) diferente(s)</strong> detectados:
            @resultado.Puestos.Existentes.Count existente(s),
            @resultado.Puestos.NuevosPropuestos.Count nuevo(s) propuesto(s) y
            @resultado.Puestos.Ambiguos.Count ambiguo(s).
            Afectan a @resultado.Puestos.TrabajadoresAfectados fila(s).
        </div>

        @if (resultado.Puestos.NuevosPropuestos.Count > 0)
        {
            <div class="aviso aviso-atencion" role="status">
                <strong>Nuevos puestos propuestos:</strong>
                <ul class="nota-compacta">
                    @foreach (var puesto in resultado.Puestos.NuevosPropuestos)
                    {
                        <li>
                            <strong>@puesto.Nombre</strong> — @puesto.Empresa
                            (@puesto.TrabajadoresAfectados trabajador(es))
                        </li>
                    }
                </ul>
            </div>
        }

        @if (resultado.Puestos.Ambiguos.Count > 0)
        {
            <div class="aviso aviso-error" role="alert">
                <strong>No se puede confirmar mientras haya puestos ambiguos.</strong>
                <ul class="nota-compacta">
                    @foreach (var puesto in resultado.Puestos.Ambiguos)
                    {
                        <li>
                            <strong>@puesto.Valor</strong> — @puesto.Empresa:
                            @string.Join(", ", puesto.Candidatos)
                        </li>
                    }
                </ul>
            </div>
        }
        else
        {
            <div class="aviso aviso-exito" role="status">
                Se registraron <strong>@resultado.Creados</strong> de @resultado.FilasLeidas
                fila(s) de <code>@resultado.NombreArchivo</code>.
                @if (resultado.TieneErrores)
                {
                    <text>@resultado.Rechazados quedaron sin registrar.</text>
                }
            </div>
        }

        @if (resultado.MarcadoresRegistrados.Count > 0)
        {
            <div class="aviso aviso-exito" role="status">
                @(resultado.SoloValidacion ? "Se registrarían" : "Se registraron")
                <strong>@resultado.MarcadoresRegistrados.Count</strong> ID de marcador nuevo(s)
                en el catálogo. Revise que ninguno esté mal escrito:
                <ul class="nota-compacta">
                    @foreach (var grupo in resultado.MarcadoresRegistrados.GroupBy(m => m.Equipo))
                    {
                        <li><strong>@grupo.Key</strong>: @string.Join(", ", grupo.Select(m => m.Codigo))</li>
                    }
                </ul>
            </div>
        }

        @if (resultado.FilasSinMarcadorEnCatalogo > 0)
        {
            <div class="aviso aviso-atencion" role="status">
                <strong>@resultado.FilasSinMarcadorEnCatalogo fila(s)</strong> traen un ID de
                marcador que no está en el catálogo, y la casilla «Registrar en el catálogo los
                ID de marcador que falten» estaba apagada. Vuelva a subir el archivo con la
                casilla marcada para registrarlos al cargar.
            </div>
        }

        @if (resultado.TieneErrores)
        {
            <div class="tabla-contenedor">
                <table class="tabla">
                    <thead>
                        <tr>
                            <th>Fila</th>
                            <th>Documento</th>
                            <th>Motivo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var error in resultado.Errores)
                        {
                            <tr>
                                <td>@error.Fila</td>
                                <td>@error.Referencia</td>
                                <td>@error.Motivo</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="nota-pie">
                El número de fila es el que muestra Excel: la fila 1 es el encabezado.
            </p>
        }

        @if (resultado.SoloValidacion)
        {
            <div class="acciones">
                <form method="post" asp-action="CancelarCargaMasiva">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="token" value="@Model.TokenConfirmacion" />
                    <button type="submit" class="boton boton-secundario">Cancelar</button>
                </form>

                @if (Model.PuedeConfirmar)
                {
                    <form method="post" asp-action="ConfirmarCargaMasiva">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="token" value="@Model.TokenConfirmacion" />
                        <button type="submit" class="boton boton-primario">
                            Confirmar importación
                        </button>
                    </form>
                }
            </div>
        }
        else
        {
            <div class="acciones">
                <a class="boton boton-secundario" asp-controller="PreparacionTareo" asp-action="Index">
                    Revisar preparación para tareo
                </a>
            </div>
        }
    </div>
}
