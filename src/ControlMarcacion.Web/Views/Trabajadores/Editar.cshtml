@using ControlMarcacion.Application.Personal
@model EditarTrabajadorVm
@{
    ViewData["Title"] = Model.EsNuevo ? "Nuevo trabajador" : "Editar trabajador";
}

<div class="titulo-pagina">
    <h1>@ViewData["Title"]</h1>
    <a class="boton boton-secundario" asp-action="Index">Volver al listado</a>
</div>

<form method="post" asp-action="Guardar">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Datos.Id" />

    @* El cese no se edita desde aquí: tiene su propia pantalla porque exige motivo y
       cierra las asignaciones vigentes. Viaja oculto para que el servicio pueda validar
       el rango de fechas contra lo que el trabajador ya tiene registrado. *@
    <input type="hidden" asp-for="Datos.FechaCese" />
    <input type="hidden" asp-for="Datos.MotivoCese" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="aviso aviso-error" role="alert">
            <strong>No se pudo guardar. Revise lo siguiente:</strong>
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <div class="tarjeta">
        <h2>Datos personales</h2>
        <div class="rejilla">
            <div class="campo">
                <label asp-for="Datos.TipoDocumentoId">Tipo de documento</label>
                @* Las opciones se arman a mano, y no con SelectList, para que cada una
                   lleve la longitud y el formato que admite su tipo. Así el campo de al
                   lado se acota solo, con la regla del catálogo y no con uno cableado. *@
                <select asp-for="Datos.TipoDocumentoId" class="select-buscable"
                        data-restringe-documento="#Datos_NumeroDocumento">
                    <option value="">Seleccione…</option>
                    @foreach (var tipo in Model.TiposDocumento)
                    {
                        <option value="@tipo.Id"
                                data-maximo="@tipo.MaximoCaracteres"
                                data-exacta="@(tipo.LongitudExacta?.ToString() ?? string.Empty)"
                                data-solo-digitos="@(tipo.SoloDigitos ? "1" : "0")">@tipo.Nombre</option>
                    }
                </select>
                <span class="error-campo" asp-validation-for="Datos.TipoDocumentoId"></span>
            </div>

            <div class="campo">
                <label asp-for="Datos.NumeroDocumento">Número de documento</label>
                @* type="text", nunca "number": un DNI que empieza en cero pierde el dígito.
                   El maxlength real lo pone documento-restriccion.js según el tipo elegido;
                   este 20 es el ancho de la columna y solo actúa si aún no se eligió tipo. *@
                <input asp-for="Datos.NumeroDocumento" type="text" maxlength="20" autocomplete="off" />
                <span class="error-campo" asp-validation-for="Datos.NumeroDocumento"></span>
            </div>

            <div class="campo">
                <label asp-for="Datos.ApellidoPaterno">Apellido paterno</label>
                <input asp-for="Datos.ApellidoPaterno" type="text" maxlength="80" />
                <span class="error-campo" asp-validation-for="Datos.ApellidoPaterno"></span>
            </div>

            <div class="campo">
                <label asp-for="Datos.ApellidoMaterno">Apellido materno</label>
                <input asp-for="Datos.ApellidoMaterno" type="text" maxlength="80" />
                <span class="error-campo" asp-validation-for="Datos.ApellidoMaterno"></span>
            </div>

            <div class="campo">
                <label asp-for="Datos.Nombres">Nombres</label>
                <input asp-for="Datos.Nombres" type="text" maxlength="120" />
                <span class="error-campo" asp-validation-for="Datos.Nombres"></span>
            </div>

            <div class="campo">
                <label asp-for="Datos.Sexo">Sexo</label>
                <select asp-for="Datos.Sexo">
                    <option value="@((int)Sexo.Masculino)">Masculino</option>
                    <option value="@((int)Sexo.Femenino)">Femenino</option>
                </select>
            </div>

            <div class="campo">
                <label asp-for="Datos.Telefono">Teléfono</label>
                <input asp-for="Datos.Telefono" type="text" maxlength="30" />
            </div>

            <div class="campo">
                <label asp-for="Datos.CorreoElectronico">Correo electrónico</label>
                <input asp-for="Datos.CorreoElectronico" type="email" maxlength="150" />
                <span class="error-campo" asp-validation-for="Datos.CorreoElectronico"></span>
            </div>

            <div class="campo">
                <label asp-for="Datos.Direccion">Dirección</label>
                <input asp-for="Datos.Direccion" type="text" maxlength="250" />
            </div>

            <div class="campo campo-casilla">
                <input asp-for="Datos.TieneHijos" type="checkbox" />
                <label asp-for="Datos.TieneHijos">Tiene hijos</label>
            </div>
        </div>
    </div>

    <div class="tarjeta">
        <h2>Datos laborales</h2>
        <div class="rejilla">
            <div class="campo">
                <label asp-for="Datos.EmpresaId">Empresa</label>
                <select asp-for="Datos.EmpresaId" id="EmpresaId" class="select-buscable"
                        asp-items="@(new SelectList(Model.Empresas, "Id", "Nombre"))">
                    <option value="">Seleccione…</option>
                </select>
                <span class="error-campo" asp-validation-for="Datos.EmpresaId"></span>
            </div>

            <div class="campo">
                <label asp-for="Datos.TipoPlanilla">Tipo de planilla</label>
                <select asp-for="Datos.TipoPlanilla">
                    <option value="@((int)TipoPlanilla.Obrero)">Obrero (OBM)</option>
                    <option value="@((int)TipoPlanilla.Empleado)">Empleado (EMP)</option>
                </select>
            </div>

            @* "Unidad" es el nombre que usa GCA para lo que el sistema llama planta: son
               lo mismo. Antes había además un campo de texto libre "Unidad" que ya no se
               captura — dos formas de escribir el mismo dato solo consiguen que discrepen. *@
            <div class="campo">
                <label asp-for="Datos.PlantaId">Unidad (planta)</label>
                <select asp-for="Datos.PlantaId" id="PlantaId" class="select-buscable"
                        asp-items="@(new SelectList(Model.Plantas, "Id", "Nombre"))">
                    <option value="">Seleccione…</option>
                </select>
                <span class="error-campo" asp-validation-for="Datos.PlantaId"></span>
            </div>

            <div class="campo">
                <label asp-for="Datos.PuestoId">Puesto</label>
                <select asp-for="Datos.PuestoId" id="PuestoId" class="select-buscable"
                        asp-items="@(new SelectList(Model.Puestos, "Id", "Nombre"))">
                    <option value="">Seleccione…</option>
                </select>
                <span class="error-campo" asp-validation-for="Datos.PuestoId"></span>
            </div>

            <div class="campo">
                <label asp-for="Datos.FechaIngreso">Fecha de ingreso</label>
                <input asp-for="Datos.FechaIngreso" type="date" />
                <span class="error-campo" asp-validation-for="Datos.FechaIngreso"></span>
            </div>

            <div class="campo">
                <label asp-for="Datos.MontoSueldoBasico">Sueldo básico mensual (S/)</label>
                <input asp-for="Datos.MontoSueldoBasico" type="number" step="0.01" min="0" />
                <span class="error-campo" asp-validation-for="Datos.MontoSueldoBasico"></span>
            </div>

            <div class="campo">
                <label asp-for="CentroId">Centro</label>
                <select asp-for="CentroId" id="CentroId" class="select-buscable"
                        asp-items="@(new SelectList(Model.Centros, "Id", "Nombre"))">
                    <option value="">Seleccione…</option>
                </select>
            </div>

            <div class="campo">
                <label asp-for="Datos.CentroCostoId">Centro de costo</label>
                <select asp-for="Datos.CentroCostoId" id="CentroCostoId" class="select-buscable"
                        asp-items="@(new SelectList(Model.CentrosCosto, "Id", "Nombre"))">
                    <option value="">Seleccione…</option>
                </select>
            </div>
        </div>

        <p class="nota-pie">
            Centro y Centro de costo son el catálogo real de SAP entregado por GCA. A
            diferencia del ID de marcador, el turno y el sueldo, esta asignación
            <b>no</b> lleva vigencia por fecha.
        </p>
    </div>

    <div class="tarjeta">
        <h2>Marcador y turno</h2>
        <div class="rejilla">
            <div class="campo">
                <label asp-for="Datos.IdMarcador">ID de marcador</label>
                <select asp-for="Datos.IdMarcador" id="IdMarcador" class="select-buscable"
                        asp-items="@(new SelectList(Model.Marcadores, "Valor", "Nombre"))">
                    <option value="">Sin marcador asignado</option>
                </select>
                <span class="error-campo" asp-validation-for="Datos.IdMarcador"></span>
                <small class="texto-suave">
                    Solo se ofrecen los marcadores de la unidad elegida. Si falta alguno,
                    regístrelo en <a asp-controller="Marcadores" asp-action="Index">Marcadores</a>.
                </small>
            </div>

            <div class="campo">
                <label asp-for="Datos.TurnoId">Turno</label>
                <select asp-for="Datos.TurnoId" id="TurnoId" class="select-buscable"
                        asp-items="@(new SelectList(Model.Turnos, "Id", "Nombre"))">
                    <option value="">Sin turno asignado</option>
                </select>
            </div>
        </div>

        <p class="nota-pie">
            El identificador del marcador, el turno y el sueldo básico se guardan con
            vigencia por fecha. Al cambiarlos se cierra la asignación anterior y se abre una
            nueva, para que las marcaciones y los tareos ya registrados sigan calculándose
            con lo que estaba vigente entonces.
        </p>
    </div>

    @if (!Model.EsNuevo)
    {
        <div class="tarjeta">
            <h2>Situación</h2>

            @if (Model.Datos.FechaCese is { } cese)
            {
                <p>
                    <span class="etiqueta etiqueta-incompleto">Cesado</span>
                    el <strong>@cese.ToString("dd/MM/yyyy")</strong>
                    @if (Model.Datos.MotivoCese is { } motivo)
                    {
                        <text>por <strong>@EtiquetasPersonal.Describir(motivo)</strong></text>
                    }
                </p>
            }
            else
            {
                <p>
                    <span class="etiqueta etiqueta-puntual">Activo</span>
                    Para cambiarlo de empresa primero debe registrar su baja, con fecha de
                    cese y motivo.
                </p>
            }

            <div class="acciones">
                @if (Model.Datos.FechaCese is null)
                {
                    <a class="boton boton-secundario" asp-action="Baja" asp-route-id="@Model.Datos.Id">
                        Registrar baja
                    </a>
                }
                <a class="boton boton-secundario" asp-action="Historial" asp-route-id="@Model.Datos.Id">
                    Ver historial
                </a>
            </div>
        </div>
    }

    <div class="acciones">
        <button type="submit" class="boton boton-primario">Guardar</button>
        <a class="boton boton-secundario" asp-action="Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <script src="~/js/trabajador-form.js" asp-append-version="true"></script>
    <script src="~/js/documento-restriccion.js" asp-append-version="true"></script>
}
