@model TareoVm
@using System.Globalization
@using ControlMarcacion.Application.Asistencia
@using ControlMarcacion.Domain.Asistencia
@{
    ViewData["Title"] = "Tareo";

    var cultura = CultureInfo.CurrentCulture;
    var r = Model.Resultado;
    var resumen = Model.Resumen;


    // Los minutos se guardan enteros y se presentan en h:mm. La conversión es
    // presentación pura: el dato que viaja y se paga sigue siendo el minuto.
    static string Horas(int minutos) => minutos == 0 ? "—" : $"{minutos / 60}:{minutos % 60:00}";

    static string ClaseEstado(EstadoTareo estado) => estado switch
    {
        EstadoTareo.Puntual => "etiqueta-puntual",
        EstadoTareo.Tardanza => "etiqueta-tardanza",
        EstadoTareo.Falta => "etiqueta-falta",
        EstadoTareo.AusenciaJustificada => "etiqueta-justificada",
        EstadoTareo.Incompleto => "etiqueta-incompleto",
        EstadoTareo.PendienteValidacion => "etiqueta-incompleto",
        EstadoTareo.DescansoSustitutorio => "etiqueta-justificada",
        _ => "etiqueta-sin-horario"
    };

    static string NombreEstado(EstadoTareo estado) => estado switch
    {
        EstadoTareo.Puntual => "Puntual",
        EstadoTareo.Tardanza => "Tardanza",
        EstadoTareo.Falta => "Falta",
        EstadoTareo.AusenciaJustificada => "Justificada",
        EstadoTareo.Incompleto => "Incompleto",
        EstadoTareo.SinHorario => "Sin horario",
        EstadoTareo.Descanso => "Descanso",
        EstadoTareo.Feriado => "Feriado",
        EstadoTareo.SinVinculo => "Sin vínculo",
        EstadoTareo.PendienteValidacion => "Pendiente de validar",
        EstadoTareo.DescansoSustitutorio => "Descanso sustitutorio",
        _ => estado.ToString()
    };

    // Orden fijo, de lo que exige atención a lo que no. Los estados se muestran SIEMPRE
    // todos, con cero incluido: una tabla cuyas columnas aparecen y desaparecen según
    // los datos obliga a releer las cabeceras en cada carga, y un cero es información
    // —"ninguna falta"— que la ausencia de la pastilla no transmite.
    var ordenEstados = new[]
    {
        EstadoTareo.Falta,
        EstadoTareo.PendienteValidacion,
        EstadoTareo.Tardanza,
        EstadoTareo.Incompleto,
        EstadoTareo.AusenciaJustificada,
        EstadoTareo.Puntual,
        EstadoTareo.Descanso,
        EstadoTareo.Feriado,
        EstadoTareo.DescansoSustitutorio,
        EstadoTareo.SinHorario,
        EstadoTareo.SinVinculo
    };
}

@*
    El encabezado lleva el contexto y la acción. «Recalcular» tenía una tarjeta entera para
    un solo botón, y empujaba el detalle —lo que se viene a ver— trescientos píxeles hacia
    abajo. Una acción única va donde viven las acciones: junto al título.
*@
<div class="titulo-pagina titulo-tareo">
    <div class="titulo-tareo-contexto">
        <h1>Tareo diario</h1>

        @if (Model.PeriodoSeleccionado is { } cabecera)
        {
            <span class="texto-suave">
                @cabecera.Codigo · @cabecera.FechaInicio.ToString("dd/MM/yyyy", cultura)
                al @cabecera.FechaFin.ToString("dd/MM/yyyy", cultura)
                @if (cabecera.EstaAbierto)
                {
                    <span class="etiqueta etiqueta-puntual separado">Abierto</span>
                }
                else
                {
                    <span class="etiqueta etiqueta-incompleto separado">Cerrado</span>
                }
            </span>
        }
    </div>

    @if (Model.PeriodoSeleccionado is { EstaAbierto: true } abierto)
    {
        <div class="en-linea">
            <a class="boton boton-secundario" asp-controller="PreparacionTareo" asp-action="Index"
               asp-route-periodoId="@abierto.Id" asp-route-operacion="@((int)OperacionPreparacionTareo.Recalculo)">
                Ver preparación
            </a>
            <form method="post" asp-action="Recalcular" class="en-linea">
                @Html.AntiForgeryToken()
                <input type="hidden" name="periodoId" value="@abierto.Id" />
                <button type="submit" class="boton boton-primario"
                        data-confirmar="¿Recalcular el tareo de @abierto.Codigo? Se rehará el cálculo de todos los días del periodo. El resultado es idéntico si nada cambió: el recálculo es idempotente.">
                    Recalcular @abierto.Codigo
                </button>
            </form>
        </div>
    }
</div>

@if (Model.Periodos.Count == 0)
{
    <div class="tarjeta">
        <div class="sin-resultados">
            No hay periodos registrados. Cree uno en
            <a asp-controller="Periodos" asp-action="Index">Periodos</a> antes de calcular el tareo.
        </div>
    </div>

    @* Sin periodos no hay nada más que mostrar: los filtros quedarían con un desplegable
       vacío y el listado repetiría el mismo mensaje con otras palabras. *@
    return;
}

@* ------------------------------------------------------------------ Filtros ---- *@

<div class="tarjeta tarjeta-filtros">

    @*
        Barra en una sola línea, no una rejilla de tarjetas de formulario: son tres campos
        cortos y el botón, y apilarlos en tres columnas de 220 px con sus etiquetas encima
        ocupaba media pantalla antes de llegar a un solo dato.
    *@
    <form method="get" asp-action="Index" class="barra-filtros">
        @* La página vuelve a 1 en cada búsqueda nueva: mantenerla dejaría al usuario en
           la página 7 de un resultado que ahora tiene dos. *@
        <input type="hidden" name="pagina" value="1" />

        <div class="campo campo-filtro campo-filtro-ancho">
            <label for="periodoId">Periodo</label>
            <select id="periodoId" name="periodoId" class="select-buscable">
                @foreach (var p in Model.Periodos)
                {
                    <option value="@p.Id" selected="@(Model.PeriodoId == p.Id)">
                        @p.Codigo — @p.Nombre (@p.FechaInicio.ToString("dd/MM", cultura) al @p.FechaFin.ToString("dd/MM/yyyy", cultura))
                    </option>
                }
            </select>
        </div>

        <div class="campo campo-filtro campo-filtro-ancho">
            <label for="busqueda">Trabajador</label>
            <input type="search" id="busqueda" name="busqueda" value="@Model.Busqueda"
                   placeholder="Apellidos, nombres o documento" autocomplete="off" />
        </div>

        <div class="campo campo-filtro">
            <label for="estado">Estado</label>
            <select id="estado" name="estado" class="select-buscable">
                <option value="">Todos</option>
                @foreach (var e in ordenEstados)
                {
                    <option value="@((int)e)" selected="@(Model.Estado == e)">@NombreEstado(e)</option>
                }
            </select>
        </div>

        <div class="barra-filtros-acciones">
            <button type="submit" class="boton boton-primario">Ver</button>
            @if (Model.HayFiltroActivo)
            {
                <a class="boton boton-secundario"
                   asp-action="Index" asp-route-periodoId="@Model.PeriodoId">Limpiar</a>
            }
        </div>
    </form>

    @*
        Los filtros aplicados, cada uno con su aspa. Un desplegable y una caja de texto ya
        muestran su valor, pero hay que mirarlos de uno en uno: la tira dice de un vistazo
        por qué el listado trae lo que trae, y permite soltar UN filtro sin perder el otro
        —que era la única opción con «Quitar filtros»—.
    *@
    @if (Model.HayFiltroActivo)
    {
        <div class="filtros-activos">
            <span class="filtros-activos-rotulo">Filtrando por</span>

            @if (!string.IsNullOrWhiteSpace(Model.Busqueda))
            {
                <a class="filtro-activo"
                   asp-action="Index"
                   asp-all-route-data='new Dictionary<string, string?>(Model.RutaFiltros()) { ["busqueda"] = null }'>
                    Trabajador: <strong>@Model.Busqueda</strong>
                    <span class="filtro-activo-quitar" aria-hidden="true">×</span>
                </a>
            }

            @if (Model.Estado is { } estadoActivo)
            {
                <a class="filtro-activo"
                   asp-action="Index" asp-all-route-data="@Model.RutaFiltros(null)">
                    Estado: <strong>@NombreEstado(estadoActivo)</strong>
                    <span class="filtro-activo-quitar" aria-hidden="true">×</span>
                </a>
            }
        </div>
    }
</div>

@* ------------------------------------------------------------------ Resumen ---- *@

@if (resumen.HayDatos)
{
    <div class="tarjeta">
        <h2>Resumen del periodo</h2>

        <p class="subtitulo">
            Calculado sobre el periodo completo@(string.IsNullOrWhiteSpace(Model.Busqueda)
                ? "" : " que coincide con la búsqueda"), no sobre la página que se ve.
            <strong>Pulse un estado para filtrar por él.</strong>
        </p>

        <div class="tira-indicadores">
            <div class="indicador">
                <span class="indicador-cifra">@resumen.Trabajadores.ToString("N0", cultura)</span>
                <span class="indicador-rotulo">Trabajadores</span>
            </div>
            <div class="indicador">
                <span class="indicador-cifra">@resumen.Dias.ToString("N0", cultura)</span>
                <span class="indicador-rotulo">Días calculados</span>
            </div>
            <div class="indicador">
                <span class="indicador-cifra">@Horas(resumen.MinutosExtra)</span>
                <span class="indicador-rotulo">Sobretiempo (h)</span>
            </div>
            <div class="indicador @(resumen.MinutosTardanza > 0 ? "indicador-alerta" : "")">
                <span class="indicador-cifra">@Horas(resumen.MinutosTardanza)</span>
                <span class="indicador-rotulo">Tardanza (h)</span>
            </div>
            <div class="indicador">
                <span class="indicador-cifra">@Horas(resumen.MinutosNocturnos)</span>
                <span class="indicador-rotulo">Nocturno (h)</span>
            </div>
        </div>

        <div class="pastillas-estado">
            <a class="pastilla-estado @(Model.Estado is null ? "activa" : "")"
               asp-action="Index" asp-all-route-data="@Model.RutaFiltros(null)">
                <span class="pastilla-estado-cifra">@resumen.Dias.ToString("N0", cultura)</span>
                <span class="pastilla-estado-nombre">Todos</span>
            </a>

            @foreach (var e in ordenEstados)
            {
                var conteo = resumen.Conteo(e);

                <a class="pastilla-estado @ClaseEstado(e) @(Model.Estado == e ? "activa" : "") @(conteo == 0 ? "en-cero" : "")"
                   asp-action="Index" asp-all-route-data="@Model.RutaFiltros(e)">
                    <span class="pastilla-estado-cifra">@conteo.ToString("N0", cultura)</span>
                    <span class="pastilla-estado-nombre">@NombreEstado(e)</span>
                </a>
            }
        </div>
    </div>
}

@*
    El botón de recalcular vive en el encabezado. Aquí solo queda el aviso del periodo
    cerrado, que sí es una condición de la pantalla y no una acción.
*@
@if (Model.PeriodoSeleccionado is { EstaAbierto: false } cerrado)
{
    <div class="aviso aviso-alerta" role="status">
        El periodo <strong>@cerrado.Codigo</strong> está <strong>cerrado</strong>: su tareo
        está congelado y no puede recalcularse. Reábralo desde
        <a asp-controller="Periodos" asp-action="Index">Periodos</a>, indicando el motivo,
        si corresponde rehacer el cálculo.
    </div>
}

@* ------------------------------------------------------------ Liquidación ---- *@

@if (Model.Liquidacion is { } liq && resumen.HayDatos)
{
    <details class="tarjeta bloque-plegable">
        <summary class="bloque-plegable-cabecera">
            <span class="bloque-plegable-titulo">Liquidación del periodo</span>
            <span class="bloque-plegable-detalle">
                @liq.TotalHorasEquivalentes.ToString("N2", cultura) horas equivalentes
                @if (liq.HayConceptosSinTasa)
                {
                    <span class="etiqueta etiqueta-falta">Hay conceptos sin tasa</span>
                }
            </span>
        </summary>

        <div class="bloque-plegable-cuerpo">
            <p class="subtitulo">
                El sistema <strong>no calcula dinero</strong>: no conoce ninguna remuneración.
                Entrega los minutos por concepto y la tasa que regía en esas fechas, con su base
                legal, para que planilla multiplique. La columna <em>equivalente</em> expresa esa
                aplicación en tiempo: 120 min al 25 % equivalen a 150 min de jornada ordinaria.
                Los derechos remunerados expresados en días se muestran aparte: no son minutos
                trabajados y por eso no se convierten ni se suman a este total.
            </p>

            @if (liq.HayConceptosSinTasa)
            {
                <div class="aviso aviso-error" role="alert">
                    <strong>Hay conceptos con minutos acumulados y sin tasa vigente</strong>
                    para las fechas de este periodo:
                    @string.Join(", ", liq.SinTasa.Select(c => c.Etiqueta)).
                    Ese trabajo no se puede valorizar hasta que se cargue la tasa correspondiente.
                </div>
            }

            @if (liq.HayComponentesRemuneracionDiaria)
            {
                <h3>Derechos de remuneración diaria</h3>
                <div class="tabla-contenedor">
                    <table class="tabla">
                        <thead>
                            <tr>
                                <th>Concepto</th>
                                <th class="col-numero">Días-persona</th>
                                <th>Tratamiento</th>
                                <th>Base legal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in liq.ComponentesDiariosConDerecho)
                            {
                                <tr>
                                    <td>@c.Etiqueta</td>
                                    <td class="col-numero">@c.CantidadDias.ToString("N0", cultura)</td>
                                    <td>
                                        @(c.IncluidoEnRemuneracionBase
                                            ? "Incluido en la remuneración base"
                                            : "Pago diario adicional")
                                    </td>
                                    <td class="celda-nota">@c.BaseLegal</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="tabla-contenedor">
                <table class="tabla">
                    <thead>
                        <tr>
                            <th>Concepto</th>
                            <th class="col-numero">Horas físicas</th>
                            <th class="col-numero">Base económica</th>
                            <th class="col-numero">Sobretasa</th>
                            <th class="col-numero">Horas equivalentes</th>
                            <th>Base legal</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Jornada ordinaria</strong></td>
                            <td class="col-numero">@liq.HorasOrdinarias.ToString("N2", cultura)</td>
                            <td class="col-numero">@liq.HorasOrdinarias.ToString("N2", cultura)</td>
                            <td class="col-numero">—</td>
                            <td class="col-numero">@liq.HorasOrdinarias.ToString("N2", cultura)</td>
                            <td>—</td>
                        </tr>
                        @foreach (var c in liq.Conceptos.Where(x => x.Minutos > 0))
                        {
                            <tr>
                                <td>@c.Etiqueta</td>
                                <td class="col-numero">@c.Horas.ToString("N2", cultura)</td>
                                <td class="col-numero">@((c.MinutosBaseEconomica / 60m).ToString("N2", cultura))</td>
                                <td class="col-numero">
                                    @if (c.TieneTasaVigente)
                                    {
                                        <strong>+@c.Porcentaje.ToString("N0", cultura) %</strong>
                                        <small>(@((c.MinutosRecargo / 60m).ToString("N2", cultura)) h)</small>
                                    }
                                    else
                                    {
                                        <span class="etiqueta etiqueta-falta">Sin tasa</span>
                                    }
                                </td>
                                <td class="col-numero">@c.HorasEquivalentes.ToString("N2", cultura)</td>
                                <td class="celda-nota">@(c.BaseLegal ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>Total en horas equivalentes</th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th class="col-numero">@liq.TotalHorasEquivalentes.ToString("N2", cultura)</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </details>
}

@* ---------------------------------------------------------------- Listado ---- *@

<div class="tarjeta">
    <h2>Detalle por trabajador y día</h2>

    @if (r.TotalElementos == 0)
    {
        <div class="sin-resultados">
            @if (Model.HayFiltroActivo)
            {
                <text>
                    Ningún día del periodo coincide con los filtros.
                    <a asp-action="Index" asp-route-periodoId="@Model.PeriodoId">Quitarlos</a>
                    para ver el tareo completo.
                </text>
            }
            else
            {
                <text>No hay tareo calculado para este periodo. Use «Recalcular» para generarlo.</text>
            }
        </div>
    }
    else
    {
        <p class="subtitulo">
            @r.TotalElementos.ToString("N0", cultura) trabajador(es) con días calculados.
            Esta página muestra @r.Elementos.Count, con sus
            @Model.DiasEnLaPagina.ToString("N0", cultura) día(s) — <strong>el mes de cada
            persona entero</strong>, nunca partido entre dos páginas.
        </p>

        <div class="tabla-contenedor">
            @*
                Una sola tabla con cabeceras de persona intercaladas, no una tabla por
                trabajador: así las columnas quedan alineadas entre unos y otros, que es lo
                que permite comparar de un vistazo. Las columnas Trabajador e ID salieron
                del cuerpo —viven en la cabecera de cada bloque—, y de catorce se bajó a doce.
            *@
            <table class="tabla tabla-tareo">
                <thead>
                    @*
                        Dos filas de cabecera: las columnas de minutos no son nueve cosas
                        distintas sino tres grupos, y sin ellos hay que leer el rótulo de
                        cada una para saber si "35 %" es sobretiempo o descuento.
                    *@
                    <tr class="fila-grupos">
                        <th></th>
                        <th colspan="3" class="grupo-marca">Jornada</th>
                        <th colspan="5" class="grupo-tiempo">Tiempo computado (h)</th>
                        <th colspan="2" class="grupo-desvio">Desvíos (min)</th>
                        <th></th>
                    </tr>
                    <tr>
                        <th>Fecha</th>
                        <th>Turno</th>
                        <th>Entrada</th>
                        <th>Salida</th>
                        <th class="col-numero">Trabajado</th>
                        <th class="col-numero">Ordinario</th>
                        <th class="col-numero">Extra 25%</th>
                        <th class="col-numero">Extra 35%</th>
                        <th class="col-numero">Nocturno</th>
                        <th class="col-numero">Tardanza</th>
                        <th class="col-numero">Sal. antic.</th>
                        <th>Estado</th>
                    </tr>
                </thead>

                @foreach (var persona in r.Elementos)
                {
                    @*
                        Un <tbody> por persona: agrupa semánticamente y permite teñir el
                        bloque entero sin repetir la clase en cada fila.
                    *@
                    <tbody class="bloque-trabajador">
                        <tr class="fila-trabajador">
                            <th colspan="12" scope="colgroup">
                                <span class="trabajador-nombre">@persona.Trabajador</span>
                                @* El aparato va junto al ID: con dos equipos en una planta,
                                   «ID 14» a secas lo llevan dos personas distintas. *@
                                <span class="trabajador-id">ID @(persona.IdMarcador ?? "—")@(persona.Equipo is null ? "" : " · " + persona.Equipo)</span>

                                @* Totales de ESTA persona. Son completos porque la página
                                   trae a cada trabajador entero: ver TareoDeTrabajador. *@
                                <span class="trabajador-totales">
                                    @if (Model.Estado is { } filtrado)
                                    {
                                        <text>
                                            @persona.TotalDias día(s) con estado
                                            «@NombreEstado(filtrado)»
                                        </text>
                                    }
                                    else
                                    {
                                        <text>@persona.TotalDias día(s)</text>

                                        if (persona.Faltas > 0)
                                        {
                                            <span class="etiqueta etiqueta-falta">@persona.Faltas falta(s)</span>
                                        }

                                        if (persona.Tardanzas > 0)
                                        {
                                            <span class="etiqueta etiqueta-tardanza">@persona.Tardanzas tardanza(s)</span>
                                        }

                                        if (persona.MinutosExtra > 0)
                                        {
                                            <text>· @Horas(persona.MinutosExtra) h extra</text>
                                        }
                                    }
                                </span>
                            </th>
                        </tr>

                        @foreach (var t in persona.Dias)
                        {
                            var esDomingo = t.Fecha.DayOfWeek == DayOfWeek.Sunday;

                            <tr class="@(t.EsDiaNoLaborable ? "fila-no-laborable" : "")">
                                <td class="celda-fecha @(esDomingo ? "celda-domingo" : "")">
                                    @t.Fecha.ToString("dd/MM", cultura)
                                    <small class="texto-suave">@t.Fecha.ToString("ddd", cultura)</small>
                                </td>
                                <td>@(t.Turno ?? "—")</td>
                                <td>@(t.EntradaReal?.ToString("HH:mm", cultura) ?? "—")</td>
                                <td>@(t.SalidaReal?.ToString("HH:mm", cultura) ?? "—")</td>
                                <td class="col-numero"><strong>@Horas(t.MinutosTrabajados)</strong></td>
                                <td class="col-numero">@Horas(t.MinutosOrdinarios)</td>
                                <td class="col-numero">@Horas(t.MinutosExtra25)</td>
                                <td class="col-numero">@Horas(t.MinutosExtra35)</td>
                                <td class="col-numero">@Horas(t.MinutosNocturnos)</td>
                                <td class="col-numero @(t.MinutosTardanza > 0 ? "cifra-alerta" : "")">
                                    @(t.MinutosTardanza == 0 ? "—" : t.MinutosTardanza.ToString("N0", cultura))
                                </td>
                                <td class="col-numero @(t.MinutosSalidaAnticipada > 0 ? "cifra-alerta" : "")">
                                    @(t.MinutosSalidaAnticipada == 0 ? "—" : t.MinutosSalidaAnticipada.ToString("N0", cultura))
                                </td>
                                <td>
                                    <span class="etiqueta @ClaseEstado(t.Estado)">@NombreEstado(t.Estado)</span>
                                    @if (t.TipoDiaNoLaborable == TipoDiaNoLaborable.DescansoSemanal)
                                    {
                                        <span class="etiqueta etiqueta-justificada">Descanso +100%</span>
                                    }
                                    else if (t.TipoDiaNoLaborable == TipoDiaNoLaborable.Feriado
                                             && t.TieneDescansoSustitutorio)
                                    {
                                        <span class="etiqueta etiqueta-justificada">
                                            Feriado sustituido → @t.FechaDescansoSustitutorio?.ToString("dd/MM")
                                        </span>
                                    }
                                    else if (t.TipoDiaNoLaborable == TipoDiaNoLaborable.Feriado)
                                    {
                                        <span class="etiqueta etiqueta-justificada">Feriado +100%</span>
                                    }
                                </td>
                            </tr>

                            @*
                                La observación va en su propia fila y no en un title: es la
                                explicación de por qué salió ese resultado —invariante del
                                sistema: cada resultado se explica— y un tooltip no se
                                imprime, no se copia y no existe en pantalla táctil.
                            *@
                            @if (!string.IsNullOrWhiteSpace(t.Observacion))
                            {
                                <tr class="fila-observacion @(t.EsDiaNoLaborable ? "fila-no-laborable" : "")">
                                    <td colspan="12">
                                        <span class="marca-observacion" aria-hidden="true">↳</span>
                                        @t.Observacion

                                        @*
                                            La salida hacia donde se resuelve. Sin esto había
                                            que salir a otra pantalla y volver a teclear
                                            trabajador y fecha, justo cuando uno ya tiene el
                                            día delante.
                                        *@
                                        @if (t.RequiereValidacion)
                                        {
                                            <span class="etiqueta etiqueta-incompleto">
                                                @BandejaIncidenciasVm.Nombre(t.TipoIncidencia)
                                            </span>
                                            <a asp-controller="Incidencias" asp-action="Index"
                                               asp-route-periodoId="@Model.PeriodoId"
                                               asp-route-trabajadorId="@t.TrabajadorId">Resolver</a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                }
            </table>
        </div>

        <partial name="_Paginacion"
                 model='PaginacionVm.De(r, "Index", "trabajador(es)", Model.RutaFiltros())' />
    }
</div>

@section Scripts {
    <script src="~/js/confirmar-accion.js" asp-append-version="true"></script>
}
