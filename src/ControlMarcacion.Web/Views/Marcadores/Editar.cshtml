@model EditarMarcadorVm
@{
    ViewData["Title"] = Model.EsNuevo ? "Nuevo marcador" : "Editar marcador";
}

<div class="titulo-pagina">
    <h1>@ViewData["Title"]</h1>
    <a class="boton boton-secundario" asp-action="Index">Volver al catálogo</a>
</div>

<form method="post" asp-action="Guardar">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Datos.Id" />
    <input type="hidden" asp-for="AsignacionesTotales" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="aviso aviso-error" role="alert">
            <strong>No se pudo guardar. Revise lo siguiente:</strong>
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    @if (!Model.HayEquipos)
    {
        <div class="aviso aviso-error" role="alert">
            <strong>No hay ningún equipo registrado.</strong> Un código de marcador pertenece
            a un aparato, así que primero hay que dar de alta el equipo ZKTeco en
            <a asp-controller="Equipos" asp-action="Editar">Equipos marcadores</a>.
        </div>
    }

    <div class="tarjeta">
        <div class="rejilla">
            <div class="campo">
                <label asp-for="Datos.Codigo">Código del marcador</label>
                <input asp-for="Datos.Codigo" type="text" maxlength="30" readonly="@Model.EstaEnUso" />
                <span class="error-campo" asp-validation-for="Datos.Codigo"></span>
                <small class="texto-suave">
                    Tal como lo escribe el equipo en el archivo, con los ceros a la izquierda
                    incluidos (por ejemplo <code>00123</code>).
                </small>
            </div>

            <div class="campo">
                <label asp-for="Datos.EquipoId">Equipo</label>
                <select asp-for="Datos.EquipoId" class="select-buscable"
                        disabled="@Model.EstaEnUso"
                        asp-items="@(Model.Equipos.Select(e => new SelectListItem(
                            $"{e.Planta} · {e.Nombre}", e.Id.ToString())))">
                    <option value="">Seleccione…</option>
                </select>
                <span class="error-campo" asp-validation-for="Datos.EquipoId"></span>
                <small class="texto-suave">
                    El aparato que emite este código. La <strong>planta se hereda del
                    equipo</strong>: no se captura aquí para que no puedan quedar en
                    desacuerdo.
                </small>

                @if (Model.EstaEnUso)
                {
                    @* Un select deshabilitado no se envía. *@
                    <input type="hidden" asp-for="Datos.EquipoId" />
                }
            </div>

            <div class="campo">
                <label asp-for="Datos.Descripcion">Descripción</label>
                <input asp-for="Datos.Descripcion" type="text" maxlength="150"
                       placeholder="Ubicación o referencia del equipo" />
                <span class="error-campo" asp-validation-for="Datos.Descripcion"></span>
            </div>

            <div class="campo campo-casilla">
                <input asp-for="Datos.Activo" type="checkbox" />
                <label asp-for="Datos.Activo">Activo</label>
            </div>
        </div>

        @if (Model.EstaEnUso)
        {
            <div class="aviso aviso-error" role="status">
                Este marcador tiene <strong>@Model.AsignacionesTotales asignación(es)</strong>
                registradas, así que ni su código ni su equipo se pueden cambiar. Las
                asignaciones se resuelven por <strong>(equipo, código, fecha)</strong>:
                tocar cualquiera de los dos dejaría esas marcaciones sin dueño —irían al
                reporte de «IDs sin trabajador»— y, si en el equipo de destino ese código ya
                es de alguien, se atribuirían a la persona equivocada. Si el dato está mal,
                dé de baja este marcador y cree uno nuevo.
            </div>
        }
    </div>

    <div class="acciones">
        <button type="submit" class="boton boton-primario" disabled="@(!Model.HayEquipos)">Guardar</button>
        <a class="boton boton-secundario" asp-action="Index">Cancelar</a>
    </div>
</form>
