@model ListaFeriadosVm
@{
    ViewData["Title"] = "Feriados";
}

<div class="titulo-pagina">
    <h1>Feriados</h1>
</div>

<div class="tarjeta">
    <p style="color: var(--color-texto-suave); margin-top: 0;">
        Sincronización manual contra un proveedor externo (Nager.Date, cubre Perú): trae los
        feriados nacionales del año elegido y agrega <strong>solo los que falten</strong>.
        Nunca borra ni reemplaza un feriado ya cargado, sea de una sincronización anterior o
        de un feriado local de planta cargado a mano. El cálculo del tareo siempre lee esta
        misma tabla — nunca llama a internet al calcular.
    </p>

    <form method="get" asp-action="Index" id="form-ver-anio">
        <div class="rejilla">
            <div class="campo">
                <label for="anio">Año</label>
                <input type="number" id="anio" name="anio" value="@Model.Anio" min="2000" max="2100" />
            </div>
        </div>

        <div class="acciones">
            <button type="submit" class="boton boton-secundario">Ver</button>
        </div>
    </form>

    @* Formulario aparte: un <form> no puede anidar otro <form>, y este además necesita su
       propio antiforgery token porque hace un POST distinto. *@
    <form method="post" asp-action="Sincronizar" class="acciones">
        @Html.AntiForgeryToken()
        <input type="hidden" name="anio" value="@Model.Anio" />
        <button type="submit" class="boton boton-primario"
                data-confirmar="¿Sincronizar los feriados de @Model.Anio contra el servicio externo? Requiere conexión a internet.">
            Sincronizar @Model.Anio
        </button>
    </form>
</div>

<div class="tarjeta">
    @if (Model.Feriados.Count == 0)
    {
        <div class="sin-resultados">
            No hay feriados cargados para @Model.Anio. Use "Sincronizar" para traer los
            nacionales, o cárguelos a mano desde el módulo de catálogos si son locales de planta.
        </div>
    }
    else
    {
        <div class="tabla-contenedor">
            <table class="tabla">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Descripción</th>
                        <th>Alcance</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model.Feriados)
                    {
                        <tr>
                            <td>@f.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@f.Descripcion</td>
                            <td>@(f.PlantaNombre ?? "Todas las plantas")</td>
                            <td>
                                @if (f.Activo)
                                {
                                    <span class="etiqueta etiqueta-puntual">Activo</span>
                                }
                                else
                                {
                                    <span class="etiqueta etiqueta-incompleto">Inactivo</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="paginacion">
            <span class="conteo">@Model.Feriados.Count feriado(s)</span>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/confirmar-accion.js" asp-append-version="true"></script>
}
