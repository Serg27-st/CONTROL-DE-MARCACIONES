@model EditarSolicitudVm
@{
    ViewData["Title"] = "Nueva solicitud";
}

<div class="titulo-pagina">
    <h1>Nueva solicitud de ausencia</h1>
    <a class="boton boton-secundario" asp-action="Index">Volver al listado</a>
</div>

<form method="post" asp-action="Guardar">
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="aviso aviso-error" role="alert">
            <strong>No se pudo guardar. Revise lo siguiente:</strong>
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <div class="tarjeta">
        <h2>Datos de la solicitud</h2>
        <div class="rejilla">
            <div class="campo">
                <label asp-for="Datos.TrabajadorId">Trabajador</label>
                <select asp-for="Datos.TrabajadorId" class="select-buscable"
                        asp-items="@(new SelectList(Model.Trabajadores, "Id", "Nombre"))">
                    <option value="">Seleccione…</option>
                </select>
                <span class="error-campo" asp-validation-for="Datos.TrabajadorId"></span>
            </div>

            <div class="campo">
                <label asp-for="Datos.TipoAusenciaId">Tipo de ausencia</label>
                @* Las opciones se arman a mano y no con asp-items para poder colgar de cada
                   una su código y sus topes: así el aviso de límite lo dicta el catálogo y
                   no una copia de las reglas escrita en JavaScript. *@
                <select asp-for="Datos.TipoAusenciaId" id="tipo-ausencia" class="select-buscable">
                    <option value="">Seleccione…</option>
                    @foreach (var tipo in Model.TiposAusencia)
                    {
                        @* Sin selected= a mano: el tag helper del <select> ya marca la
                           opción que coincide con el modelo al volver con errores. *@
                        <option value="@tipo.Id"
                                data-codigo="@tipo.Codigo"
                                data-maximo-evento="@(tipo.MaximoDiasPorEvento?.ToString() ?? "")"
                                data-maximo-anio="@(tipo.MaximoDiasPorAnioCalendario?.ToString() ?? "")"
                                data-detalle-clinico="@(tipo.RequiereDetalleClinico ? "1" : "0")">
                            @tipo.Etiqueta
                        </option>
                    }
                </select>
                <span class="error-campo" asp-validation-for="Datos.TipoAusenciaId"></span>
                <p id="aviso-limite" class="nota-limite" hidden></p>
            </div>

            <div class="campo" id="campo-subtipo-vacaciones" hidden>
                <label asp-for="Datos.SubtipoVacaciones">Tipo de vacaciones</label>
                <select asp-for="Datos.SubtipoVacaciones" id="subtipo-vacaciones" class="select-buscable">
                    <option value="">Seleccione…</option>
                    <option value="GOZADAS">Vacaciones gozadas</option>
                    <option value="VENTA">Venta de vacaciones</option>
                </select>
                <span class="error-campo" asp-validation-for="Datos.SubtipoVacaciones"></span>
                <p id="aviso-subtipo" class="nota-limite" hidden></p>
            </div>

            <div class="campo" id="campo-periodo-gozadas" hidden>
                <label for="periodo-gozadas">Periodo vacacional</label>
                @* Dos controles para un solo campo del modelo: el que está oculto se
                   deshabilita, y un control deshabilitado no se envía, así que nunca llegan
                   dos valores de PeriodoVacacional al servidor. *@
                <select id="periodo-gozadas" name="Datos.PeriodoVacacional" class="select-buscable" disabled>
                    <option value="">Seleccione…</option>
                    @foreach (var periodo in Model.PeriodosVacacionales)
                    {
                        <option value="@periodo" selected="@(Model.Datos.PeriodoVacacional == periodo)">
                            @periodo
                        </option>
                    }
                </select>
                <span class="error-campo" asp-validation-for="Datos.PeriodoVacacional"></span>
            </div>

            <div class="campo" id="campo-periodo-venta" hidden>
                <label for="periodo-venta">Periodo vacacional</label>
                @* El title acompaña al aviso nativo del pattern: sin él, el navegador
                   muestra su propio texto genérico y en su propio idioma. *@
                <input type="text" id="periodo-venta" name="Datos.PeriodoVacacional"
                       value="@Model.Datos.PeriodoVacacional"
                       maxlength="9" placeholder="2025-2026" pattern="\d{4}-\d{4}"
                       title="Escriba el periodo como AAAA-AAAA, por ejemplo 2025-2026."
                       autocomplete="off" disabled />
                <span class="error-campo" id="error-periodo-venta"></span>
            </div>

            <div class="campo">
                <label asp-for="Datos.FechaInicio">Fecha de inicio</label>
                <input asp-for="Datos.FechaInicio" type="date" />
                <span class="error-campo" asp-validation-for="Datos.FechaInicio"></span>
            </div>

            <div class="campo">
                <label asp-for="Datos.FechaFin">Fecha de fin</label>
                <input asp-for="Datos.FechaFin" type="date" />
                <span class="error-campo" asp-validation-for="Datos.FechaFin"></span>
            </div>

            <div class="campo">
                <label asp-for="Datos.HoraInicio">Hora de inicio (solo permisos por horas)</label>
                <input asp-for="Datos.HoraInicio" type="time" />
                <span class="error-campo" asp-validation-for="Datos.HoraInicio"></span>
            </div>

            <div class="campo">
                <label asp-for="Datos.HoraFin">Hora de fin (solo permisos por horas)</label>
                <input asp-for="Datos.HoraFin" type="time" />
                <span class="error-campo" asp-validation-for="Datos.HoraFin"></span>
            </div>
        </div>

        <p class="nota-pie">
            Si el tipo elegido se registra por horas, la fecha de inicio y la de fin deben
            coincidir: un permiso por horas es de un solo día.
        </p>
    </div>

    <div class="tarjeta">
        <h2>Sustento</h2>
        <div class="rejilla">
            <div class="campo">
                <label asp-for="Datos.Sustento">
                    Descripción del sustento <span class="obligatorio" aria-hidden="true">*</span>
                </label>
                <input asp-for="Datos.Sustento" type="text" maxlength="500" minlength="5" required />
                <span class="error-campo" asp-validation-for="Datos.Sustento"></span>
            </div>

            <div class="campo">
                <label asp-for="Datos.RutaDocumentoSustento">Ruta del documento</label>
                <input asp-for="Datos.RutaDocumentoSustento" type="text" maxlength="400" />
            </div>

            <div class="campo">
                <label asp-for="Datos.Observacion">Observación</label>
                <input asp-for="Datos.Observacion" type="text" maxlength="500" />
            </div>
        </div>

        <p class="nota-pie">
            La descripción del sustento es obligatoria: es lo que explica, meses después, por
            qué ese día no quedó como falta. El <strong>documento</strong> (certificado médico,
            resolución) sí puede adjuntarse más tarde, antes de aprobar.
        </p>
    </div>

    @* Solo aparece en los tipos subsidiados —descanso médico y los dos subsidios—, que son
       los que alimentan la hoja "Descanso Medico" del tareo final. Qué tipos son lo dice el
       catálogo a través de data-detalle-clinico, no una lista de códigos en JavaScript. *@
    <div class="tarjeta" id="bloque-detalle-clinico" hidden>
        <h2>Detalle clínico</h2>
        <p class="subtitulo">
            Son las tres columnas que planilla venía llenando a mano en la hoja
            <strong>Descanso Medico</strong> del tareo final.
        </p>

        <div class="rejilla">
            <div class="campo">
                <label asp-for="Datos.Contingencia">
                    Contingencia <span class="obligatorio" aria-hidden="true">*</span>
                </label>
                <select asp-for="Datos.Contingencia" id="contingencia">
                    <option value="">Seleccione…</option>
                    <option value="@((int)Contingencia.EnfermedadComun)">Enfermedad común</option>
                    <option value="@((int)Contingencia.AccidenteLaboral)">Accidente laboral</option>
                </select>
                <span class="error-campo" asp-validation-for="Datos.Contingencia"></span>
            </div>

            <div class="campo">
                <label asp-for="Datos.CentroAtencion">
                    Centro de atención <span class="obligatorio" aria-hidden="true">*</span>
                </label>
                <select asp-for="Datos.CentroAtencion" id="centro-atencion">
                    <option value="">Seleccione…</option>
                    <option value="@((int)CentroAtencion.Essalud)">EsSalud</option>
                    <option value="@((int)CentroAtencion.Particular)">Particular</option>
                </select>
                <span class="error-campo" asp-validation-for="Datos.CentroAtencion"></span>
            </div>

            <div class="campo">
                <label asp-for="Datos.Diagnostico">
                    Diagnóstico <span class="obligatorio" aria-hidden="true">*</span>
                </label>
                <input asp-for="Datos.Diagnostico" id="diagnostico" type="text" maxlength="250" />
                <span class="error-campo" asp-validation-for="Datos.Diagnostico"></span>
            </div>
        </div>

        <p class="nota-pie">
            El diagnóstico es un <strong>dato sensible de salud</strong> (Ley 29733).
            La bitácora de auditoría deja constancia de que alguien lo cambió, nunca de su
            contenido. Escriba lo que consta en el certificado médico, sin agregar detalle.
        </p>
    </div>

    <div class="acciones">
        <button type="submit" class="boton boton-primario">Registrar solicitud</button>
        <a class="boton boton-secundario" asp-action="Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <script src="~/js/solicitudes-crear.js" asp-append-version="true"></script>
}
