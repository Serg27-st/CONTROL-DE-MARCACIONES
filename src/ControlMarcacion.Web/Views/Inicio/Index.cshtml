@{
    ViewData["Title"] = "Inicio";

    // Inicio es la única pantalla abierta a cualquier rol autenticado. El panel con el
    // estado de los módulos es de COORDINADOR y GERENCIA; los demás roles entran a hacer
    // su trabajo, no a mirar el tablero. Dentro del panel, cada fila se muestra solo si
    // el rol puede abrir ese módulo: un enlace que responde 403 no es información útil.
    var esCoordinador = User.IsInRole(RolesSistema.Coordinador);
    var gestionaTareo = esCoordinador || User.IsInRole(RolesSistema.Administrador);
    var veSolicitudes = gestionaTareo || User.IsInRole(RolesSistema.TrabajadorSocial);
    var veReportes = esCoordinador || User.IsInRole(RolesSistema.Gerencia);
    var vePanel = esCoordinador || User.IsInRole(RolesSistema.Gerencia);
}

<div class="titulo-pagina">
    <h1>Panel de control</h1>
</div>

<div class="tarjeta">
    <h2>Bienvenido</h2>
    <p>
        Sistema de control de asistencia y cálculo de tareo para <strong>GCA</strong>,
        cliente <strong>Intradevco</strong>.
    </p>
    <p style="color: var(--color-texto-suave);">
        <strong>Marcador en duro + justificaciones = resultado final.</strong>
        Las marcaciones que llegan del ZKTeco no se modifican nunca; toda corrección se
        registra como justificación mientras el periodo esté abierto.
    </p>

    @if (!vePanel)
    {
        <p style="color: var(--color-texto-suave); margin-bottom: 0;">
            Use el menú superior para ir a su trabajo.
            @if (gestionaTareo)
            {
                <text>Tiene acceso a Personal, Marcaciones, Solicitudes, Justificaciones, Tareo y Catálogos.</text>
            }
            else if (veSolicitudes)
            {
                <text>Tiene acceso a Solicitudes de ausencia.</text>
            }
            else
            {
                <text>Si no ve ninguna opción, pida a su coordinador que revise el rol de su cuenta.</text>
            }
        </p>
    }
</div>

@if (vePanel)
{
    <div class="tarjeta">
        <h2>Módulos</h2>
        <div class="tabla-contenedor">
            <table class="tabla">
                <thead>
                    <tr>
                        <th>Módulo</th>
                        <th>Estado</th>
                        <th>Descripción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (gestionaTareo)
                    {
                        <tr>
                            <td><a asp-controller="Trabajadores" asp-action="Index">Personal</a></td>
                            <td><span class="etiqueta etiqueta-puntual">Disponible</span></td>
                            <td>Ficha del trabajador, datos personales y laborales, ID de marcador y turno</td>
                        </tr>
                        <tr>
                            <td><a asp-controller="Catalogos" asp-action="Index">Catálogos</a></td>
                            <td><span class="etiqueta etiqueta-puntual">Disponible</span></td>
                            <td>Puestos, plantas, áreas, secciones, tipos de documento y turnos</td>
                        </tr>
                        <tr>
                            <td><a asp-controller="Marcaciones" asp-action="Index">Marcaciones</a></td>
                            <td><span class="etiqueta etiqueta-puntual">Disponible</span></td>
                            <td>Carga del TXT del ZKTeco G3, con deduplicación y reporte de rechazos</td>
                        </tr>
                    }
                    @if (gestionaTareo)
                    {
                        <tr>
                            <td><a asp-controller="Periodos" asp-action="Index">Periodos</a></td>
                            <td><span class="etiqueta etiqueta-puntual">Disponible</span></td>
                            <td>Rango de fechas, ciclo de apertura y cierre, detección de días huérfanos</td>
                        </tr>
                    }
                    @if (veSolicitudes)
                    {
                        <tr>
                            <td><a asp-controller="Solicitudes" asp-action="Index">Solicitudes</a></td>
                            <td><span class="etiqueta etiqueta-puntual">Disponible</span></td>
                            <td>Vacaciones, descansos médicos, licencias y permisos, con aprobación</td>
                        </tr>
                    }
                    @if (gestionaTareo)
                    {
                        <tr>
                            <td><a asp-controller="Justificaciones" asp-action="Index">Justificaciones</a></td>
                            <td><span class="etiqueta etiqueta-puntual">Disponible</span></td>
                            <td>Corrección auditable de ausencias y tardanzas, con periodo abierto</td>
                        </tr>
                        <tr>
                            <td><a asp-controller="Asistencia" asp-action="Index">Tareo</a></td>
                            <td><span class="etiqueta etiqueta-puntual">Disponible</span></td>
                            <td>Motor de cálculo, sobretasas y horas extras según normativa peruana</td>
                        </tr>
                    }
                    @if (veReportes)
                    {
                        <tr>
                            <td><a asp-controller="Reportes" asp-action="Index">Reportes</a></td>
                            <td><span class="etiqueta etiqueta-puntual">Disponible</span></td>
                            <td>Resumen mensual, excepciones y tareo final, exportables a Excel</td>
                        </tr>
                    }
                    @if (esCoordinador)
                    {
                        <tr>
                            <td><a asp-controller="Usuarios" asp-action="Index">Usuarios</a></td>
                            <td><span class="etiqueta etiqueta-puntual">Disponible</span></td>
                            <td>Alta de cuentas, rol y plantas que gestiona cada administrador</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
