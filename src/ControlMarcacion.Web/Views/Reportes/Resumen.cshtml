@model ResumenTareoVm
@using System.Globalization
@{
    ViewData["Title"] = "Resumen de tareo";
    ViewData["AccionFiltro"] = "Resumen";
    ViewData["AccionExportar"] = "ExportarResumen";

    var cultura = CultureInfo.CurrentCulture;
    var r = Model.Resultado;
    var t = Model.Totales;

    string Horas(decimal h) => h == 0 ? "—" : h.ToString("N2", cultura);
    string Dias(int d) => d == 0 ? "—" : d.ToString("N0", cultura);
    string Soles(decimal s) => s == 0 ? "—" : "S/ " + s.ToString("N2", cultura);
}

<div class="titulo-pagina">
    <h1>Resumen de tareo</h1>
    <a class="boton boton-secundario" asp-action="Index">Volver a reportes</a>
</div>

<partial name="_FiltroReporte" model="Model" />

@if (!Model.HayAlcanceSeleccionado)
{
    <div class="tarjeta">
        <div class="sin-resultados">Elija un alcance para ver el resumen.</div>
    </div>
}
else
{
    <div class="tarjeta">
        @if (r.TotalElementos == 0)
        {
            <div class="sin-resultados">
                No hay tareo calculado para este alcance y estos filtros. Recalcule el periodo
                desde <a asp-controller="Asistencia" asp-action="Index">Tareo</a>.
            </div>
        }
        else
        {
            <div class="tabla-contenedor">
                @*
                    Cabecera de dos niveles: dieciocho columnas donde once son cifras no son
                    dieciocho cosas distintas, sino identificación, días por estado, horas y
                    dinero. Sin los grupos hay que leer el rótulo de cada una para saber si
                    "35 %" son horas o soles.
                *@
                <table class="tabla tabla-resumen">
                    <thead>
                        <tr class="fila-grupos">
                            <th colspan="5"></th>
                            <th colspan="6" class="grupo-marca">Días por estado</th>
                            <th colspan="5" class="grupo-tiempo">Horas acumuladas</th>
                            <th colspan="2" class="grupo-desvio">Conceptos en soles</th>
                        </tr>
                        <tr>
                            <th>Trabajador</th>
                            <th>ID</th>
                            <th>Planta</th>
                            <th>Centro</th>
                            <th>Centro de costo</th>
                            <th class="col-numero">Puntual</th>
                            <th class="col-numero">Tardanza</th>
                            <th class="col-numero">Falta</th>
                            <th class="col-numero">Justificada</th>
                            <th class="col-numero">Incompleto</th>
                            <th class="col-numero">No laborable</th>
                            <th class="col-numero">Ordinarias</th>
                            <th class="col-numero">Extra 25%</th>
                            <th class="col-numero">Extra 35%</th>
                            <th class="col-numero">Nocturnas</th>
                            <th class="col-numero">Tardanza</th>
                            <th class="col-numero">Bono nocturno</th>
                            <th class="col-numero">Movilidad</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in r.Elementos)
                        {
                            <tr>
                                <td class="celda-trabajador"><strong>@f.Trabajador</strong></td>
                                <td><code>@(f.IdMarcador ?? "—")</code></td>
                                <td>@f.Planta</td>
                                <td>@(f.Centro ?? "—")</td>
                                <td>@(f.CentroCosto ?? "—")</td>
                                <td class="col-numero">@Dias(f.DiasPuntual)</td>
                                <td class="col-numero @(f.DiasTardanza > 0 ? "cifra-alerta" : "")">@Dias(f.DiasTardanza)</td>
                                <td class="col-numero @(f.DiasFalta > 0 ? "cifra-alerta" : "")">@Dias(f.DiasFalta)</td>
                                <td class="col-numero">@Dias(f.DiasAusenciaJustificada)</td>
                                <td class="col-numero @(f.DiasIncompleto > 0 ? "cifra-alerta" : "")">@Dias(f.DiasIncompleto)</td>
                                <td class="col-numero">@Dias(f.DiasNoLaborableTrabajado)</td>
                                <td class="col-numero">@Horas(f.HorasOrdinarias)</td>
                                <td class="col-numero">@Horas(f.HorasExtra25)</td>
                                <td class="col-numero">@Horas(f.HorasExtra35)</td>
                                <td class="col-numero">@Horas(f.HorasNocturnas)</td>
                                <td class="col-numero">@Horas(f.HorasTardanza)</td>
                                <td class="col-numero">@Soles(f.MontoBonoNocturno)</td>
                                <td class="col-numero">@Soles(f.MontoMovilidad)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        @*
                            El TOTAL es del ALCANCE COMPLETO, no de esta página. Antes se
                            sumaba aquí recorriendo las filas recibidas; con paginación eso
                            habría pasado a ser "el total de lo que se ve" sin que nada lo
                            delatara, en el reporte que se entrega a planilla. Ahora lo
                            calcula el servicio y la vista solo lo imprime.
                        *@
                        <tr>
                            <th colspan="5">
                                TOTAL · @t.Trabajadores.ToString("N0", cultura) trabajador(es) del alcance
                            </th>
                            <th class="col-numero">@Dias(t.DiasPuntual)</th>
                            <th class="col-numero">@Dias(t.DiasTardanza)</th>
                            <th class="col-numero">@Dias(t.DiasFalta)</th>
                            <th class="col-numero">@Dias(t.DiasAusenciaJustificada)</th>
                            <th class="col-numero">@Dias(t.DiasIncompleto)</th>
                            <th class="col-numero">@Dias(t.DiasNoLaborableTrabajado)</th>
                            <th class="col-numero">@t.HorasOrdinarias.ToString("N2", cultura)</th>
                            <th class="col-numero">@t.HorasExtra25.ToString("N2", cultura)</th>
                            <th class="col-numero">@t.HorasExtra35.ToString("N2", cultura)</th>
                            <th class="col-numero">@t.HorasNocturnas.ToString("N2", cultura)</th>
                            <th class="col-numero">@t.HorasTardanza.ToString("N2", cultura)</th>
                            <th class="col-numero">S/ @t.MontoBonoNocturno.ToString("N2", cultura)</th>
                            <th class="col-numero">S/ @t.MontoMovilidad.ToString("N2", cultura)</th>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <partial name="_Paginacion"
                     model='PaginacionVm.De(r, "Resumen", "trabajador(es)", Model.Filtro.ARuta())' />

            <p class="nota-pie">
                La fila <strong>TOTAL</strong> suma el alcance completo, no la página que se ve.
                El <strong>Excel</strong> se exporta entero: la paginación es solo de pantalla.
            </p>
        }
    </div>
}

@section Scripts {
    <script src="~/js/reporte-filtro.js" asp-append-version="true"></script>
}
