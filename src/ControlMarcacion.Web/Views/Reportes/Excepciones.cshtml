@model ExcepcionesVm
@using System.Globalization
@{
    ViewData["Title"] = "Excepciones";
    ViewData["AccionFiltro"] = "Excepciones";
    ViewData["AccionExportar"] = "ExportarExcepciones";

    var cultura = CultureInfo.CurrentCulture;
    var r = Model.Resultado;

    static string ClaseEstado(EstadoTareo estado) => estado switch
    {
        EstadoTareo.Falta => "etiqueta-falta",
        EstadoTareo.Tardanza => "etiqueta-tardanza",
        EstadoTareo.AusenciaJustificada => "etiqueta-justificada",
        EstadoTareo.Incompleto => "etiqueta-incompleto",
        EstadoTareo.PendienteValidacion => "etiqueta-incompleto",
        _ => ""
    };

    static string NombreEstado(EstadoTareo estado) => estado switch
    {
        EstadoTareo.Falta => "Falta",
        EstadoTareo.Tardanza => "Tardanza",
        EstadoTareo.AusenciaJustificada => "Ausencia justificada",
        EstadoTareo.Incompleto => "Marcación incompleta",
        EstadoTareo.PendienteValidacion => "Pendiente de validar",
        _ => estado.ToString()
    };
}

<div class="titulo-pagina">
    <h1>Excepciones</h1>
    <a class="boton boton-secundario" asp-action="Index">Volver a reportes</a>
</div>

<partial name="_FiltroReporte" model="Model" />

@if (!Model.HayAlcanceSeleccionado)
{
    <div class="tarjeta">
        <div class="sin-resultados">Elija un alcance para ver las excepciones.</div>
    </div>
}
else
{
    <div class="tarjeta">
        @if (r.TotalElementos == 0)
        {
            <div class="sin-resultados">No hay excepciones para este alcance y estos filtros.</div>
        }
        else
        {
            <div class="tabla-contenedor">
                <table class="tabla">
                    <thead>
                        <tr>
                            <th>Trabajador</th>
                            <th>ID</th>
                            <th>Fecha</th>
                            <th>Turno</th>
                            <th>Entrada</th>
                            <th>Salida</th>
                            <th>Estado</th>
                            <th class="col-numero">Tardanza</th>
                            <th class="col-numero">Salida anticipada</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in r.Elementos)
                        {
                            <tr>
                                <td class="celda-trabajador"><strong>@e.Trabajador</strong></td>
                                <td>
                                    <code>@(e.IdMarcador ?? "—")</code>
                                    @if (e.Equipo is not null)
                                    {
                                        <br /><small class="texto-suave">@e.Equipo</small>
                                    }
                                </td>
                                <td class="celda-fecha">
                                    @e.Fecha.ToString("dd/MM/yyyy", cultura)
                                    <small class="texto-suave">@e.Fecha.ToString("ddd", cultura)</small>
                                </td>
                                <td>@(e.Turno ?? "—")</td>
                                <td>@(e.EntradaReal?.ToString("HH:mm", cultura) ?? "—")</td>
                                <td>@(e.SalidaReal?.ToString("HH:mm", cultura) ?? "—")</td>
                                <td><span class="etiqueta @ClaseEstado(e.Estado)">@NombreEstado(e.Estado)</span></td>
                                <td class="col-numero @(e.MinutosTardanza > 0 ? "cifra-alerta" : "")">
                                    @(e.MinutosTardanza == 0 ? "—" : e.MinutosTardanza.ToString("N0", cultura))
                                </td>
                                <td class="col-numero @(e.MinutosSalidaAnticipada > 0 ? "cifra-alerta" : "")">
                                    @(e.MinutosSalidaAnticipada == 0 ? "—" : e.MinutosSalidaAnticipada.ToString("N0", cultura))
                                </td>
                            </tr>

                            @* La observación va en su propia fila y no en un title: es el
                               invariante "cada resultado se explica", y un tooltip no se
                               imprime, no se copia y no existe en pantalla táctil. Mismo
                               criterio que la pantalla de Tareo. *@
                            @if (!string.IsNullOrWhiteSpace(e.Observacion))
                            {
                                <tr class="fila-observacion">
                                    <td colspan="9">
                                        <span class="marca-observacion" aria-hidden="true">↳</span>
                                        @e.Observacion
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <partial name="_Paginacion"
                     model='PaginacionVm.De(r, "Excepciones", "excepción(es)", Model.Filtro.ARuta())' />

            <p class="nota-pie">
                El <strong>Excel</strong> se exporta entero, con las
                @r.TotalElementos excepción(es) del alcance: la paginación es solo de pantalla.
            </p>
        }
    </div>
}

@section Scripts {
    <script src="~/js/reporte-filtro.js" asp-append-version="true"></script>
}
